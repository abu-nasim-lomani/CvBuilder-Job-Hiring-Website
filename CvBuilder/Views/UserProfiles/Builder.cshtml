@model CvBuilderViewModel
@{
    ViewData["Title"] = "CV Builder";
}

<form id="cv-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserProfile.Id" />

    <div class="container-fluid">
        <div class="row g-4">

            <div class="col-lg-5">
                <div class="card shadow-sm" style="height: 85vh; overflow-y: auto;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>CV Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="accordion" id="cvAccordion">

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingPersonal">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePersonal" aria-expanded="true" aria-controls="collapsePersonal">
                                        <strong>Personal Details</strong>
                                    </button>
                                </h2>
                                <div id="collapsePersonal" class="accordion-collapse collapse show" aria-labelledby="headingPersonal" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">
                                        <div class="mb-3">
                                            <label asp-for="UserProfile.FullName" class="form-label"></label>
                                            <input asp-for="UserProfile.FullName" class="form-control" />
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="UserProfile.Phone" class="form-label"></label>
                                            <input asp-for="UserProfile.Phone" class="form-control" />
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="UserProfile.Address" class="form-label"></label>
                                            <input asp-for="UserProfile.Address" class="form-control" />
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="UserProfile.LinkedInProfileUrl" class="form-label"></label>
                                            <input asp-for="UserProfile.LinkedInProfileUrl" class="form-control" />
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="UserProfile.WebsiteUrl" class="form-label"></label>
                                            <input asp-for="UserProfile.WebsiteUrl" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingSummary">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSummary" aria-expanded="false" aria-controls="collapseSummary">
                                        <strong>Summary</strong>
                                    </button>
                                </h2>
                                <div id="collapseSummary" class="accordion-collapse collapse" aria-labelledby="headingSummary" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">
                                        <textarea asp-for="UserProfile.Summary" class="form-control" rows="5"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingExperience">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExperience" aria-expanded="false" aria-controls="collapseExperience">
                                        <strong>Experience</strong>
                                    </button>
                                </h2>
                                <div id="collapseExperience" class="accordion-collapse collapse" aria-labelledby="headingExperience" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">
                                        <div id="experience-list-container">
                                            @if (Model.UserProfile.Experiences != null)
                                            {
                                                @for (var i = 0; i < Model.UserProfile.Experiences.Count; i++)
                                                {
                                                    <partial name="_ExperienceItem" model="Model.UserProfile.Experiences[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                                                }
                                            }
                                        </div>
                                        <div class="mt-3">
                                            <button type="button" id="add-experience-button" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-plus-circle me-1"></i> Add New Experience
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingEducation">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEducation" aria-expanded="false" aria-controls="collapseEducation">
                                        <strong>Education</strong>
                                    </button>
                                </h2>
                                <div id="collapseEducation" class="accordion-collapse collapse" aria-labelledby="headingEducation" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">

                                        <div id="education-list-container">
                                            @if (Model.UserProfile.Educations != null)
                                            {
                                                @for (var i = 0; i < Model.UserProfile.Educations.Count; i++)
                                                {
                                                    <partial name="_EducationItem" model="Model.UserProfile.Educations[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                                                }
                                            }
                                        </div>

                                        <div class="mt-3">
                                            <button type="button" id="add-education-button" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-plus-circle me-1"></i> Add New Education
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingSkills">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSkills" aria-expanded="false" aria-controls="collapseSkills">
                                        <strong>Skills</strong>
                                    </button>
                                </h2>
                                <div id="collapseSkills" class="accordion-collapse collapse" aria-labelledby="headingSkills" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">

                                        <div id="skill-list-container">
                                            @if (Model.UserProfile.Skills != null)
                                            {
                                                @for (var i = 0; i < Model.UserProfile.Skills.Count; i++)
                                                {
                                                    <partial name="_SkillItem" model="Model.UserProfile.Skills[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                                                }
                                            }
                                        </div>

                                        <div class="mt-3">
                                            <button type="button" id="add-skill-button" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-plus-circle me-1"></i> Add New Skill
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingProjects">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProjects" aria-expanded="false" aria-controls="collapseProjects">
                                        <strong>Projects</strong>
                                    </button>
                                </h2>
                                <div id="collapseProjects" class="accordion-collapse collapse" aria-labelledby="headingProjects" data-bs-parent="#cvAccordion">
                                    <div class="accordion-body">

                                        <div id="project-list-container">
                                            @if (Model.UserProfile.Projects != null)
                                            {
                                                @for (var i = 0; i < Model.UserProfile.Projects.Count; i++)
                                                {
                                                    <partial name="_ProjectItem" model="Model.UserProfile.Projects[i]" view-data='new ViewDataDictionary(ViewData) { { "index", i } }' />
                                                }
                                            }
                                        </div>

                                        <div class="mt-3">
                                            <button type="button" id="add-project-button" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-plus-circle me-1"></i> Add New Project
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @* Add Accordion items for Skills and Projects similarly *@
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm" style="height: 85vh; display: flex; flex-direction: column;">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <label for="templateId" class="form-label mb-0 me-2">Template:</label>
                            <select asp-for="SelectedTemplateId" id="templateId" name="SelectedTemplateId" class="form-select-sm" asp-items="@(new SelectList(Model.AvailableTemplates, "Id", "Name"))"></select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span id="save-status" class="text-muted small me-2"></span>
                            @* <button id="save-changes-button" type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1">
                                <span id="save-spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <i class="bi bi-save"></i>
                                <span id="save-text">Save Changes</span>
                            </button> *@
                            <button id="recompile-button" type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-2">
                                <span id="recompile-spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <i class="bi bi-arrow-repeat"></i>
                                <span id="recompile-text">Update Preview</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body position-relative" style="flex-grow: 1; padding: 0;">
                        <div id="initial-loader" class="d-flex justify-content-center align-items-center h-100 flex-column">
                            <div class="spinner-border text-secondary" role="status"></div>
                            <p class="mt-3 text-muted">Click 'Update Preview' to generate your CV</p>
                        </div>
                        <iframe id="pdf-preview" class="d-none" style="width: 100%; height: 100%; border: none;" title="PDF Preview"></iframe>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const recompileBtn = document.getElementById('recompile-button');
            const cvForm = document.getElementById('cv-form');
            const previewFrame = document.getElementById('pdf-preview');
            const initialLoader = document.getElementById('initial-loader');
            const recompileSpinner = document.getElementById('recompile-spinner');
            const addExperienceButton = document.getElementById('add-experience-button');
            const experienceListContainer = document.getElementById('experience-list-container');
            const saveStatus = document.getElementById('save-status');
            // const saveChangesButton = document.getElementById('save-changes-button');
            const saveSpinner = document.getElementById('save-spinner');
            const saveText = document.getElementById('save-text');
            let experienceIndex = @(Model.UserProfile.Experiences?.Count ?? 0);
            let debounceTimer;
            // --- Elements for Education ---
            const addEducationButton = document.getElementById('add-education-button');
            const educationListContainer = document.getElementById('education-list-container');
            let educationIndex = @(Model.UserProfile.Educations?.Count ?? 0);
            const addSkillButton = document.getElementById('add-skill-button');
            const skillListContainer = document.getElementById('skill-list-container');
            let skillIndex = @(Model.UserProfile.Skills?.Count ?? 0);

            const addProjectButton = document.getElementById('add-project-button');
            const projectListContainer = document.getElementById('project-list-container');
            let projectIndex = @(Model.UserProfile.Projects?.Count ?? 0);


            // --- Function to Add New Project Item ---
            const addProject = async () => {
                addProjectButton.disabled = true;
                try {
                    const response = await fetch('@Url.Action("AddProjectItem", "UserProfiles")');
                    if (!response.ok) throw new Error('Failed to load.');
                    const html = await response.text();
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html.trim();
                    const newItem = tempDiv.firstChild;
                    newItem.querySelectorAll('input, textarea, label, button').forEach(el => {
                        ['name', 'id', 'for'].forEach(attr => {
                            const currentAttrValue = el.getAttribute(attr);
                            if (currentAttrValue) {
                                const newAttrValue = currentAttrValue.replace(/\[0\]/, `[${projectIndex}]`).replace(/__0__/, `_${projectIndex}__`);
                                el.setAttribute(attr, newAttrValue);
                            }
                        });
                    });
                    projectListContainer.appendChild(newItem);
                    projectIndex++;
                } catch (error) {
                    console.error('Error adding project:', error);
                    alert('Could not add new project item.');
                } finally {
                    addProjectButton.disabled = false;
                }
            };

            // --- Function to Handle Deleting a Project Item ---
            const deleteProject = async (button) => {
                const projectItemCard = button.closest('.project-item');
                const projectIdInput = projectItemCard.querySelector('input[type="hidden"][name$=".Id"]');
                const projectId = projectIdInput ? projectIdInput.value : null;

                if (!projectId || projectId === '0') {
                    projectItemCard.remove(); return;
                }
                if (!confirm('Are you sure you want to delete this project?')) { return; }
                button.disabled = true;
                try {
                    const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch(`@Url.Action("DeleteProjectItem", "UserProfiles")?projectId=${projectId}`, {
                        method: 'POST', headers: { 'RequestVerificationToken': token }
                    });
                    if (!response.ok) throw new Error('Failed to delete item on the server.');
                    projectItemCard.remove();
                    // Optional: toastr.success('Project deleted.');
                } catch (error) {
                    console.error('Error deleting project:', error);
                    alert('Could not delete project item.');
                    button.disabled = false;
                }
            };

            // --- Add Event Listeners for Projects ---
            addProjectButton.addEventListener('click', addProject);
            projectListContainer.addEventListener('click', function(event) {
                if (event.target.classList.contains('delete-item-btn')) {
                    deleteProject(event.target);
                }
            });

             // --- Add Auto-Save Listener for Projects ---
             projectListContainer.addEventListener('input', function(event) {
                if (event.target.matches('.project-item input[type="text"], .project-item textarea')) {
                     saveStatus.textContent = 'Typing...';
                    // Need a separate trigger/debounce for projects if you want auto-save
                }
            });
            // --- Function to Add New Education Item ---
            const addEducation = async () => {
                addEducationButton.disabled = true;
                try {
                    const response = await fetch('@Url.Action("AddEducationItem", "UserProfiles")');
                    if (!response.ok) throw new Error('Failed to load.');
                    const html = await response.text();
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html.trim();
                    const newItem = tempDiv.firstChild;
                    newItem.querySelectorAll('input, textarea, select, label').forEach(el => {
                        ['name', 'id', 'for'].forEach(attr => {
                            const currentAttrValue = el.getAttribute(attr);
                            if (currentAttrValue) {
                                const newAttrValue = currentAttrValue.replace(/\[0\]/, `[${educationIndex}]`).replace(/__0__/, `_${educationIndex}__`);
                                el.setAttribute(attr, newAttrValue);
                            }
                        });
                    });
                    educationListContainer.appendChild(newItem);
                    educationIndex++;
                } catch (error) {
                    console.error('Error adding education:', error);
                    alert('Could not add new education item.');
                } finally {
                    addEducationButton.disabled = false;
                }
            };


            // --- Elements for Skills ---
            

            // --- Function to Add New Skill Item ---
            const addSkill = async () => {
                addSkillButton.disabled = true;
                try {
                    const response = await fetch('@Url.Action("AddSkillItem", "UserProfiles")');
                    if (!response.ok) throw new Error('Failed to load.');
                    const html = await response.text();
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html.trim();
                    const newItem = tempDiv.firstChild;
                    newItem.querySelectorAll('input, label, button').forEach(el => { // Include button for delete
                        ['name', 'id', 'for'].forEach(attr => {
                            const currentAttrValue = el.getAttribute(attr);
                            if (currentAttrValue) {
                                const newAttrValue = currentAttrValue.replace(/\[0\]/, `[${skillIndex}]`).replace(/__0__/, `_${skillIndex}__`);
                                el.setAttribute(attr, newAttrValue);
                            }
                        });
                    });
                    skillListContainer.appendChild(newItem);
                    skillIndex++;
                } catch (error) {
                    console.error('Error adding skill:', error);
                    alert('Could not add new skill item.');
                } finally {
                    addSkillButton.disabled = false;
                }
            };

            // --- Function to Handle Deleting a Skill Item ---
            const deleteSkill = async (button) => {
                const skillItemDiv = button.closest('.skill-item');
                const skillIdInput = skillItemDiv.querySelector('input[type="hidden"][name$=".Id"]');
                const skillId = skillIdInput ? skillIdInput.value : null;

                if (!skillId || skillId === '0') {
                    skillItemDiv.remove(); return;
                }
                if (!confirm('Are you sure you want to delete this skill?')) { return; }
                button.disabled = true;
                try {
                    const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch(`@Url.Action("DeleteSkillItem", "UserProfiles")?skillId=${skillId}`, {
                        method: 'POST', headers: { 'RequestVerificationToken': token }
                    });
                    if (!response.ok) throw new Error('Failed to delete item on the server.');
                    skillItemDiv.remove();
                    // Optional: toastr.success('Skill deleted.');
                } catch (error) {
                    console.error('Error deleting skill:', error);
                    alert('Could not delete skill item.');
                    button.disabled = false;
                }
            };

            // --- Add Event Listeners for Skills ---
            addSkillButton.addEventListener('click', addSkill);
            skillListContainer.addEventListener('click', function(event) {
                // Use closest to ensure the delete button itself triggers the action
                if (event.target.classList.contains('delete-item-btn')) {
                    deleteSkill(event.target);
                }
            });

            // --- Add Auto-Save Listener for Skills ---
             skillListContainer.addEventListener('input', function(event) {
                if (event.target.matches('.skill-item input[type="text"]')) {
                     saveStatus.textContent = 'Typing...';
                    // Need a separate trigger/debounce for skills if you want auto-save
                    // For simplicity now, we rely on the main "Save Changes" button.
                }
            });
            // --- Function to Handle Deleting an Education Item ---
            const deleteEducation = async (button) => {
                const educationItemCard = button.closest('.education-item');
                const educationIdInput = educationItemCard.querySelector('input[type="hidden"][name$=".Id"]');
                const educationId = educationIdInput ? educationIdInput.value : null;

                if (!educationId || educationId === '0') {
                    educationItemCard.remove(); return;
                }
                if (!confirm('Are you sure you want to delete this education entry?')) { return; }
                button.disabled = true;
                try {
                    const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch(`@Url.Action("DeleteEducationItem", "UserProfiles")?educationId=${educationId}`, {
                        method: 'POST', headers: { 'RequestVerificationToken': token }
                    });
                    if (!response.ok) throw new Error('Failed to delete item on the server.');
                    educationItemCard.remove();
                    // Optional: toastr.success('Education deleted.');
                } catch (error) {
                    console.error('Error deleting education:', error);
                    alert('Could not delete education item.');
                    button.disabled = false;
                }
            };

            // --- Add Event Listeners for Education ---
            addEducationButton.addEventListener('click', addEducation);
            educationListContainer.addEventListener('click', function(event) {
                if (event.target.classList.contains('delete-item-btn')) {
                    deleteEducation(event.target);
                }
            });

            // --- Add Auto-Save Listener for Education ---
             educationListContainer.addEventListener('input', function(event) {
                if (event.target.matches('.education-item input[type="text"], .education-item textarea')) {
                    saveStatus.textContent = 'Typing...';
                    // Need a separate trigger/debounce for education if you want auto-save
                    // For simplicity now, we rely on the main "Save Changes" button.
                }
            });

            function debounce(func, delay) {
                return function (...args) {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        func.apply(this, args);
                    }, delay);
                };
            }

            const triggerAutoSave = async (inputElement) => {
                const experienceItemCard = inputElement.closest('.experience-item');
                if (!experienceItemCard) return;
                const experienceIdInput = experienceItemCard.querySelector('input[type="hidden"][name$=".Id"]');
                const experienceId = experienceIdInput ? experienceIdInput.value : null;
                const fieldName = inputElement.getAttribute('name') ? inputElement.getAttribute('name').split('.').pop() : null;
                const value = inputElement.value;

                if (!experienceId || experienceId === '0' || !fieldName) {
                    saveStatus.textContent = '';
                    return;
                }

                saveStatus.textContent = 'Saving...';

                try {
                    const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const formData = new FormData();
                    formData.append('experienceId', experienceId);
                    formData.append('fieldName', fieldName);
                    formData.append('value', value);

                    const response = await fetch('@Url.Action("UpdateExperienceField", "UserProfiles")', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(errorText || 'Failed to save field.');
                    }

                    const result = await response.json();
                    saveStatus.textContent = result.message;

                } catch (error) {
                    console.error('Auto-save error:', error);
                    saveStatus.textContent = 'Error saving!';
                    alert(`Auto-Save Error: Failed to save ${fieldName}.`);
                }
            };

            const debouncedAutoSave = debounce(triggerAutoSave, 1500);

            experienceListContainer.addEventListener('input', function(event) {
                if (event.target.matches('.experience-item input[type="text"], .experience-item textarea')) {
                    saveStatus.textContent = 'Typing...';
                    debouncedAutoSave(event.target);
                }
            });

            const updatePreview = async () => {
                recompileBtn.disabled = true;
                if(recompileSpinner) recompileSpinner.classList.remove('d-none');
                previewFrame.classList.add('d-none');
                initialLoader.classList.remove('d-none');
                 if(initialLoader.querySelector('p')) initialLoader.querySelector('p').innerText = 'Generating Preview...';

                const formData = new FormData(cvForm);
                try {
                    const response = await fetch('@Url.Action("GeneratePreview", "UserProfiles")', { method: 'POST', body: formData });
                    if (!response.ok) {
                        const errorText = await response.text(); throw new Error(errorText || 'PDF generation failed.');
                    }
                    const blob = await response.blob();
                    previewFrame.src = URL.createObjectURL(blob);
                    previewFrame.classList.remove('d-none');
                    initialLoader.classList.add('d-none');
                    if(window.toastr) toastr.success('Preview updated successfully!'); else console.log('Preview updated');

                } catch (error) {
                    console.error("Error updating preview:", error);
                    alert('Compilation Failed: ' + error.message);
                } finally {
                    recompileBtn.disabled = false;
                     if(recompileSpinner) recompileSpinner.classList.add('d-none');
                }
            };

            const addExperience = async () => {
                addExperienceButton.disabled = true;
                 try {
                    const response = await fetch('@Url.Action("AddExperienceItem", "UserProfiles")');
                    if (!response.ok) throw new Error('Failed to load.');
                    const html = await response.text();
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html.trim();
                    const newItem = tempDiv.firstChild;
                    newItem.querySelectorAll('input, textarea, select, label').forEach(el => {
                         ['name', 'id', 'for'].forEach(attr => {
                            const currentAttrValue = el.getAttribute(attr);
                            if (currentAttrValue) {
                                const newAttrValue = currentAttrValue.replace(/\[0\]/, `[${experienceIndex}]`).replace(/__0__/, `_${experienceIndex}__`);
                                el.setAttribute(attr, newAttrValue);
                            }
                        });
                    });
                    experienceListContainer.appendChild(newItem);
                    experienceIndex++;
                 } catch (error) {
                     console.error('Error adding experience:', error);
                     alert('Could not add new experience item.');
                 } finally {
                     addExperienceButton.disabled = false;
                 }
            };

            const deleteExperience = async (button) => {
                const experienceItemCard = button.closest('.experience-item');
                const experienceIdInput = experienceItemCard.querySelector('input[type="hidden"][name$=".Id"]');
                const experienceId = experienceIdInput ? experienceIdInput.value : null;

                if (!experienceId || experienceId === '0') {
                    experienceItemCard.remove(); return;
                }
                if (!confirm('Are you sure you want to delete this experience?')) { return; }
                button.disabled = true;
                try {
                    const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch(`@Url.Action("DeleteExperienceItem", "UserProfiles")?experienceId=${experienceId}`, {
                        method: 'POST', headers: { 'RequestVerificationToken': token }
                    });
                    if (!response.ok) throw new Error('Failed to delete item on the server.');
                    experienceItemCard.remove();
                    if(window.toastr) toastr.success('Experience deleted.'); else console.log('Experience deleted');

                } catch (error) {
                    console.error('Error deleting experience:', error);
                    alert('Could not delete experience item.');
                    button.disabled = false;
                }
            };

            // saveChangesButton.addEventListener('click', async () => {
            //     saveChangesButton.disabled = true;
            //     saveText.textContent = 'Saving...';
            //     saveSpinner.classList.remove('d-none');
            //     saveStatus.textContent = '';

            //     const formData = new FormData(cvForm);
            //     const token = cvForm.querySelector('input[name="__RequestVerificationToken"]').value;

            //     try {
            //         const response = await fetch('@Url.Action("SaveBuilderData", "UserProfiles")', {
            //             method: 'POST',
            //             body: formData,
