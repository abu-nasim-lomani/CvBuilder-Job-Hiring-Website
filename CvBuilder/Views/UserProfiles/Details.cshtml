@model CvBuilder.Models.UserProfile

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>UserProfile</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Profession)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Profession)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Summary)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Summary)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LinkedInProfileUrl)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LinkedInProfileUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.WebsiteUrl)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.WebsiteUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ApplicationUser)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ApplicationUser.Id)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<hr />

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h4>Education</h4>
        <a asp-controller="Educations" asp-action="Create" class="btn btn-primary">Add New Education</a>
    </div>

    @if (Model.Educations != null && Model.Educations.Any())
    {
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Institution</th>
                    <th>Degree</th>
                    <th>Period</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Educations)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Institution)</td>
                        <td>@Html.DisplayFor(modelItem => item.Degree)</td>
                        <td>@item.StartDate.ToString("MMM, yyyy") - @(item.EndDate?.ToString("MMM, yyyy") ?? "Present")</td>
                        <td>
                            <a asp-controller="Educations" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-controller="Educations" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-controller="Educations" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="mt-3">No education history added yet.</p>
    }
</div>

<hr />

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h4>Work Experience</h4>
        <a asp-controller="Experiences" asp-action="Create" class="btn btn-primary">Add New Experience</a>
    </div>

    @if (Model.Experiences != null && Model.Experiences.Any())
    {
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Position</th>
                    <th>Period</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Experiences)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CompanyName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Position)</td>
                        <td>@item.StartDate.ToString("MMM, yyyy") - @(item.EndDate?.ToString("MMM, yyyy") ?? "Present")</td>
                        <td>
                            <a asp-controller="Experiences" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-controller="Experiences" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-controller="Experiences" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="mt-3">No work experience added yet.</p>
    }
</div>

<hr />

<div class="mt-4">
    <h4>Skills</h4>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (Model.Skills != null && Model.Skills.Any())
        {
            @foreach (var skill in Model.Skills)
            {
                <span class="badge bg-secondary d-flex align-items-center">
                    @skill.Name
                    <form asp-controller="Skills" asp-action="Delete" asp-route-id="@skill.Id" method="post" class="ms-2">
                        <button type="submit" class="btn-close btn-close-white" aria-label="Close" style="font-size: 0.65rem;"></button>
                    </form>
                </span>
            }
        }
        else
        {
            <p>No skills added yet.</p>
        }
    </div>

    <form asp-controller="Skills" asp-action="Create" method="post" class="row g-3 mt-3">
        <div class="col-auto">
            <input name="Name" class="form-control" placeholder="Add a new skill (e.g., C#)" required />
        </div>
        <div class="col-auto">
            <input name="Proficiency" class="form-control" placeholder="Proficiency (e.g., Expert)" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Add Skill</button>
        </div>
    </form>
</div>
<hr />

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h4>Projects</h4>
    </div>

    @if (Model.Projects != null && Model.Projects.Any())
    {
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Projects)
                {
                    <tr>
                        <td><a href="@item.Url" target="_blank">@item.Name</a></td>
                        <td>@item.Description</td>
                        <td>
                            <form asp-controller="Projects" asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="mt-3">No projects added yet.</p>
    }

    <form asp-controller="Projects" asp-action="Create" method="post" class="mt-3">
        <div class="mb-2">
            <input name="Name" class="form-control" placeholder="Project Name" required />
        </div>
        <div class="mb-2">
            <textarea name="Description" class="form-control" placeholder="Project Description"></textarea>
        </div>
        <div class="mb-2">
            <input name="Url" class="form-control" placeholder="https://github.com/your-repo" />
        </div>
        <button type="submit" class="btn btn-primary">Add Project</button>
    </form>
</div>