@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>

            <h1 class="display-4 mt-3">Oops!</h1>
            <h2 class="text-danger">An unexpected error occurred.</h2>

            <p class="lead text-muted mt-3">
                We're sorry for the inconvenience. Our team has been notified and we're working to fix it.
            </p>

            <div class="mt-4">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg me-2">
                    <i class="bi bi-house-door-fill me-1"></i> Go to Homepage
                </a>
                <button onclick="history.back()" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </button>
            </div>

            @if (Model != null && Model.ShowRequestId)
            {
                <div class="mt-5 p-3 bg-light rounded" style="font-family: monospace; font-size: 0.8rem;">
                    <strong>Request ID:</strong> @Model.RequestId
                </div>
            }

        </div>
    </div>
</div>