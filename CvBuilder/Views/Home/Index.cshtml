@{
    ViewData["Title"] = "Professional CV Builder";
}

<div class="px-4 py-5 my-5 text-center">
    <h1 class="display-4 fw-bold">Create Your Professional CV, Perfectly Formatted</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">
            Build beautiful, typeset-quality resumes with our intuitive editor and powerful LaTeX engine.
            Stand out from the crowd and land your dream job.
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="UserProfiles" asp-action="Builder" class="btn btn-primary btn-lg px-4 gap-3">
                <i class="bi bi-tools me-2"></i>Build Your CV Now
            </a>
            <a href="#features" class="btn btn-outline-secondary btn-lg px-4">Learn More</a>
        </div>
    </div>
</div>

<div id="features" class="container px-4 py-5">
    <h2 class="pb-2 border-bottom text-center">How It Works in 3 Simple Steps</h2>
    <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">

        <div class="col d-flex align-items-start">
            <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3">
                <i class="bi bi-card-text" style="font-size: 2rem;"></i>
            </div>
            <div>
                <h2>1. Add Your Information</h2>
                <p>Use our smart forms to easily add your personal details, education, work experience, skills, and projects.</p>
            </div>
        </div>

        <div class="col d-flex align-items-start">
            <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3">
                <i class="bi bi-palette" style="font-size: 2rem;"></i>
            </div>
            <div>
                <h2>2. Choose & Customize</h2>
                <p>Select from a library of professional LaTeX templates. Instantly see a live preview of your changes as you edit.</p>
            </div>
        </div>

        <div class="col d-flex align-items-start">
            <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3">
                <i class="bi bi-file-earmark-arrow-down" style="font-size: 2rem;"></i>
            </div>
            <div>
                <h2>3. Download & Apply</h2>
                <p>Generate a pixel-perfect, high-quality PDF of your CV, ready to be sent to recruiters and employers.</p>
            </div>
        </div>

    </div>
</div>

<div class="bg-light text-center p-5 rounded-3">
    <div class="col-lg-8 mx-auto">
        <h2 class="fw-bold">Ready to Create a CV That Gets Noticed?</h2>
        <p class="lead mt-3">Join thousands of professionals who trust our platform to build their careers.</p>
        <a asp-controller="UserProfiles" asp-action="Builder" class="btn btn-primary btn-lg mt-3">Get Started for Free</a>
    </div>
</div>